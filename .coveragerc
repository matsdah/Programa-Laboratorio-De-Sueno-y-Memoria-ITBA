# Configuración de la medición de cobertura. Se corre con:
#     python -m coverage run -m pytest
#     python -m coverage report
# Ver "La cobertura" en tests/README.md, que explica por qué mide líneas y no
# ramas, y por qué conviene COVERAGE_CORE=sysmon.

[run]
source = psglab
# Rutas relativas en el reporte: el CI sube uno por sistema, y Codecov los
# junta sólo si Windows y Linux nombran igual al mismo archivo.
relative_files = True

[report]
show_missing = True
skip_covered = True
exclude_also =
    if TYPE_CHECKING:
    if __name__ == .__main__.:
